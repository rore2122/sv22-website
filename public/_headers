# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Videos and images don't have hashed filenames, so cache for a week
# with revalidation rather than marking them immutable — this still
# saves repeat-visit bandwidth on mobile without risking a stale asset
# if a file is ever swapped.
/videos/*
  Cache-Control: public,max-age=604800,must-revalidate

/images/*
  Cache-Control: public,max-age=604800,must-revalidate

/favicon.ico
  Cache-Control: public,max-age=604800,must-revalidate

/*.png
  Cache-Control: public,max-age=604800,must-revalidate
